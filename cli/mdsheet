#!/usr/bin/env bash
# mdsheet — MagicDoor timesheet Google Sheets helper (Sheets API v4 via gcloud ADC)
#
# usage:
#   mdsheet [options] get '<A1range>'                    raw API JSON to stdout (values rows, newline-safe)
#   mdsheet [options] set '<singleCellRange>' <file>     on-disk file only; whole file into ONE cell (RAW, multiline-safe)
#   mdsheet [options] setmulti '<A1range>' <file>        one file line per cell, vertical COLUMNS; trailing blank line dropped; single-line cells only
#   mdsheet [options] clear '<A1range>'
#   mdsheet set-date '<singleCellRange>' '<ISO-date>'    re-anchor banner date via USER_ENTERED
#   mdsheet tabs                                         list tab names of --sheet
#   mdsheet layout                                       header row + header→column-letter map (eval-friendly)
#   mdsheet structure                                    layout + write-kind groups (daily_cols / weekly_cols)
#   mdsheet find-date '<date>'                           absolute row of DATE cell matching date (ISO or M/D)
#   mdsheet find '<name-substring>'                      list spreadsheets by name (Drive API)
#   mdsheet create '<title>'                             create a BARE spreadsheet, print its id
#   mdsheet create <MM/YYYY>                             create Hao-YYYY/MM from Hao-TEMPLATE, re-anchor, clear data
#   mdsheet copy '<sourceTitleOrId>' '<newTitle>'        full-file copy (preserves formatting; template reuse)
#   mdsheet trash '<spreadsheetId>'                      move a spreadsheet to Drive trash
#   mdsheet -h | --help
#
# options:
#   -s, --sheet <id>      spreadsheet id (required for cell/inspection modes)
#   -t, --tab <name>      tab name (default "Daily schedule")
#   --from <titleOrId>    create-source override (default: Hao-TEMPLATE)
#   --cache               cache access token in /tmp/mdsheet_token for ~50 min
#   --dry-run             print the request instead of sending it
#   -h, --help
#
# auth: Application Default Credentials (gcloud auth application-default login).
# Refresh-token rotation is handled by gcloud; never paste tokens into shells.
set -euo pipefail

SHEET_ID=""; TAB="Daily schedule"; FROM=""; DRY_RUN=0; CACHE=0
ARGS=()
while [ $# -gt 0 ]; do
  case "$1" in
    -s|--sheet) SHEET_ID="$2"; shift 2 ;;
    -t|--tab)   TAB="$2"; shift 2 ;;
    --from)     FROM="$2"; shift 2 ;;
    --cache)    CACHE=1; shift ;;
    --dry-run)  DRY_RUN=1; shift ;;
    --) shift; ARGS+=("$@"); break ;;
    -h|--help) sed -n '2,21p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    -*) echo "unknown option: $1" >&2; exit 1 ;;
    *) ARGS+=("$1"); shift ;;
  esac
done

MODE="${ARGS[0]:-}"; RANGE="${ARGS[1]:-}"

if [ "${ARGS[0]:-}" = "-h" ] || [ "${ARGS[0]:-}" = "--help" ] || [ -z "$MODE" ]; then
  sed -n '2,21p' "$0" | sed 's/^# \{0,1\}//'
  exit 0
fi

case "$MODE" in
  get|set|setmulti|clear|set-date|tabs|layout|structure|find-date)
    : "${SHEET_ID:?--sheet <id> required for cell/inspection modes (resolve first: mdsheet find 'Hao-YYYY/MM')}"
    TAB_URLSEG="${TAB// /%20}"
    ;;
  find|create|copy|trash) ;;
  *) echo "unknown mode: $MODE" >&2; exit 1 ;;
esac

token() {
  if [ "$CACHE" = 1 ] && [ -s /tmp/mdsheet_token ] && \
     [ $(( $(date +%s) - $(stat -c %Y /tmp/mdsheet_token) )) -lt 3000 ]; then
    cat /tmp/mdsheet_token; return
  fi
  gcloud auth application-default print-access-token > /tmp/mdsheet_token
  cat /tmp/mdsheet_token
}

T=$(token)
RANGE_URLSEG="${RANGE// /%20}"
if [[ "$RANGE" == *'!'* ]]; then
  URL="https://sheets.googleapis.com/v4/spreadsheets/$SHEET_ID/values/${RANGE_URLSEG}"
else
  URL="https://sheets.googleapis.com/v4/spreadsheets/$SHEET_ID/values/${TAB_URLSEG:-}!${RANGE_URLSEG}"
fi

case "$MODE" in
  get)
    if [ "$DRY_RUN" = 1 ]; then echo "GET $URL"; exit 0; fi
    curl -fsS -H "Authorization: Bearer $T" "$URL"
    ;;
  set)
    FILE="${ARGS[2]:?'set' requires a file}"
    [ -f "$FILE" ] || { echo "set requires an on-disk file (pipes//dev/stdin rejected): '$FILE'" >&2; exit 1; }
    PAYLOAD=$(python3 - "$FILE" << 'PYEOF'
import json,sys
print(json.dumps({"values":[[open(sys.argv[1]).read()]],"majorDimension":"ROWS"}))
PYEOF
)
    if [ "$DRY_RUN" = 1 ]; then echo "PUT $URL?valueInputOption=RAW"; echo "$PAYLOAD" | head -c 200; echo; exit 0; fi
    printf '%s' "$PAYLOAD" | curl -fsS -X PUT -H "Authorization: Bearer $T" -H "Content-Type: application/json" \
      --data-binary @- "$URL?valueInputOption=RAW" | head -c 200; echo
    ;;
  setmulti)
    FILE="${ARGS[2]:?'setmulti' requires a file}"
    [ -f "$FILE" ] || { echo "setmulti requires an on-disk file (pipes//dev/stdin rejected): '$FILE'" >&2; exit 1; }
    PAYLOAD=$(python3 - "$FILE" << 'PYEOF'
import json,sys
lines=[l.rstrip('\n') for l in open(sys.argv[1]).read().split('\n')]
if len(lines) > 1 and lines[-1] == '':
    lines.pop()
print(json.dumps({"values":[lines],"majorDimension":"COLUMNS"}))
PYEOF
)
    if [ "$DRY_RUN" = 1 ]; then echo "PUT $URL?valueInputOption=RAW"; echo "$PAYLOAD" | head -c 200; echo; exit 0; fi
    printf '%s' "$PAYLOAD" | curl -fsS -X PUT -H "Authorization: Bearer $T" -H "Content-Type: application/json" \
      --data-binary @- "$URL?valueInputOption=RAW" | head -c 200; echo
    ;;
  clear)
    if [ "$DRY_RUN" = 1 ]; then echo "POST $URL:clear"; exit 0; fi
    curl -fsS -X POST -H "Authorization: Bearer $T" -H "Content-Type: application/json" "$URL:clear" | head -c 200; echo
    ;;
  set-date)
    # USER_ENTERED lets Google parse the ISO string as a real date; the cell's existing
    # number format (MMMM d) keeps the banner rendering, and =C2+N chains follow suit.
    CELL="${ARGS[1]:-}"; ISO="${ARGS[2]:-}"
    [ -n "$CELL" ] && [ -n "$ISO" ] || { echo "set-date requires <singleCellRange> <ISO-date, e.g. 2026-09-01>" >&2; exit 1; }
    range_url="https://sheets.googleapis.com/v4/spreadsheets/$SHEET_ID/values/${TAB_URLSEG}!${CELL}"
    PAYLOAD=$(python3 - "$ISO" << 'PYEOF'
import json,sys
print(json.dumps({"values":[[sys.argv[1]]],"majorDimension":"ROWS"}))
PYEOF
)
    if [ "$DRY_RUN" = 1 ]; then echo "PUT $range_url?valueInputOption=USER_ENTERED"; echo "$PAYLOAD"; exit 0; fi
    printf '%s' "$PAYLOAD" | curl -fsS -X PUT -H "Authorization: Bearer $T" -H "Content-Type: application/json" \
      --data-binary @- "$range_url?valueInputOption=USER_ENTERED" | head -c 200; echo
    ;;
  tabs)
    if [ "$DRY_RUN" = 1 ]; then echo "GET spreadsheets/$SHEET_ID?fields=sheets.properties.title"; exit 0; fi
    curl -fsS -H "Authorization: Bearer $T" \
      "https://sheets.googleapis.com/v4/spreadsheets/$SHEET_ID?fields=sheets(properties.title)" \
      | python3 -c "import json,sys;[print(s['properties']['title']) for s in json.load(sys.stdin).get('sheets',[])]"
    ;;
  layout)
    if [ "$DRY_RUN" = 1 ]; then echo "GET values/${TAB_URLSEG}!A1:Z15"; exit 0; fi
    curl -fsS -H "Authorization: Bearer $T" \
      "https://sheets.googleapis.com/v4/spreadsheets/$SHEET_ID/values/${TAB_URLSEG}!A1:Z15" \
      | python3 -c "
import json,sys
import re
def L(n):
    s=''
    while n>=0:
        s=chr(n%26+65)+s; n=n//26-1
    return s
rows=json.load(sys.stdin).get('values',[])
for i,r in enumerate(rows):
    up=[str(c).strip().upper() for c in r]
    if 'DATE' in up:
        print('header_row='+str(i+1))
        for j,h in enumerate(up):
            k=re.sub(r'[^a-z0-9_]','_',h.replace(' ','_').lower()).strip('_')
            if h and k and k[0].isalpha(): print(k+'_col='+L(j))
        break
else:
    sys.stderr.write('header row with DATE not found in A1:Z15\n'); sys.exit(1)
"
    ;;
  structure)
    if [ "$DRY_RUN" = 1 ]; then echo "layout + daily/weekly grouping"; exit 0; fi
    echo "$("$0" -s "$SHEET_ID" -t "$TAB" layout)"
    eval "$("$0" -s "$SHEET_ID" -t "$TAB" layout)"
    DAILY=""
    [ -n "${task_col:-}" ] && DAILY+="task_col "
    [ -n "${pr_link_col:-}" ] && DAILY+="pr_link_col"
    WEEKLY=""
    [ -n "${notes_col:-}" ] && WEEKLY=notes_col
    echo "daily_cols=\"${DAILY% }\""
    echo "weekly_cols=\"${WEEKLY}\""
    ;;
  find-date)
    D="${ARGS[1]:-}"
    [ -n "$D" ] || { echo "find-date requires a date (ISO 2026-08-22 or M/D like 8/22)" >&2; exit 1; }
    if [ "$DRY_RUN" = 1 ]; then echo "layout + DATE column serial scan for $D"; exit 0; fi
    eval "$("$0" -s "$SHEET_ID" -t "$TAB" structure)"
    DCOL="${date_col:?structure did not report date_col}"
    START=$(( header_row + 1 )); END=$(( header_row + 220 ))
    PY='
import json,sys,datetime
arg=sys.argv[1]; start=int(sys.argv[2])
try:
    y,m,d=map(int,arg.split("-"))
except ValueError:
    y=datetime.date.today().year; m,d=map(int,arg.split("/"))
serial=int((datetime.date(y,m,d)-datetime.date(1899,12,30)).days)
texts={f"{m}/{d}", f"{m:02d}/{d}", f"{y:04d}-{m:02d}-{d:02d}"}
rows=json.load(sys.stdin).get("values",[])
for i,r in enumerate(rows):
    v=r[0] if r else ""
    if (isinstance(v,(int,float)) and int(v)==serial) or str(v).strip() in texts:
        print("row="+str(start+i)); break
else:
    sys.stderr.write("date not found in DATE column\n"); sys.exit(1)
'
    curl -fsS -H "Authorization: Bearer $T" \
      "https://sheets.googleapis.com/v4/spreadsheets/$SHEET_ID/values/${TAB_URLSEG}!${DCOL}${START}:${DCOL}${END}?valueRenderOption=UNFORMATTED_VALUE" \
      | python3 -c "$PY" "$D" "$START"
    ;;
  find)
    NAME="${ARGS[1]:-}"
    [ -n "$NAME" ] || { echo "find requires a name substring" >&2; exit 1; }
    if [ "$DRY_RUN" = 1 ]; then echo "GET drive/v3/files?q=name contains '$NAME'"; exit 0; fi
    curl -fsS -G -H "Authorization: Bearer $T" \
      --data-urlencode "q=name contains '$NAME' and mimeType='application/vnd.google-apps.spreadsheet' and trashed=false" \
      --data-urlencode "fields=files(id,name)" \
      "https://www.googleapis.com/drive/v3/files" \
      | python3 -c "import json,sys;[print(f['id'], f['name']) for f in json.load(sys.stdin).get('files',[])]"
    ;;
  create)
    TITLE="${ARGS[1]:-}"
    [ -n "$TITLE" ] || { echo "create requires a title or MM/YYYY" >&2; exit 1; }
    if [[ "$TITLE" =~ ^[0-9]{1,2}/[0-9]{4}$ ]]; then
      M="${TITLE%%/*}"; Y="${TITLE##*/}"; MM=$(printf '%02d' "$((10#$M))")
      SRC="$FROM"
      if [ -z "$SRC" ]; then
        SRC=$("$0" find 'Hao-TEMPLATE' | head -n1 | cut -d' ' -f1)
        [ -n "$SRC" ] || { echo "template sheet 'Hao-TEMPLATE' not found (create once: mdsheet copy '<anyMonth>' 'Hao-TEMPLATE')" >&2; exit 1; }
      elif [[ "$SRC" != *-*-*-** ]]; then
        SRC=$("$0" find "$SRC" | awk -v t="$SRC" '$2==t{print $1; exit}')
        [ -n "$SRC" ] || { echo "template source not found: $FROM" >&2; exit 1; }
      fi
      NAME="Hao-$Y/$M"
      if [ "$DRY_RUN" = 1 ]; then
        echo "POST drive/v3/files/$SRC/copy (name=$NAME)"
        echo "PUT ${TAB_URLSEG}!C2 = $Y-$MM-01 (USER_ENTERED)"
        echo "POST values/C5:G35:clear (data region)"
        exit 0
      fi
      BODY=$(python3 - "$NAME" << 'PYEOF'
import json,sys
print(json.dumps({'name':sys.argv[1]}))
PYEOF
)
      NEWID=$(curl -fsS -X POST -H "Authorization: Bearer $T" -H "Content-Type: application/json" -d "$BODY" \
        "https://www.googleapis.com/drive/v3/files/$SRC/copy" \
        | python3 -c "import json,sys;print(json.load(sys.stdin).get('id',''))")
      [ -n "$NEWID" ] || { echo "copy failed" >&2; exit 1; }
      "$0" -s "$NEWID" set-date 'C2' "$Y-$MM-01" > /dev/null
      DAYS=$(python3 -c "import calendar;print(calendar.monthrange($Y,$((10#$M)))[1])")
      LMAP=$("$0" -s "$NEWID" layout); eval "$LMAP"
      "$0" -s "$NEWID" clear "${task_col}5:${notes_col}$(( 4 + DAYS ))" > /dev/null
      echo "$NEWID"
      exit 0
    fi
    if [ "$DRY_RUN" = 1 ]; then echo "POST sheets/v4/spreadsheets (title=$TITLE)"; exit 0; fi
    BODY=$(python3 - "$TITLE" << 'PYEOF'
import json,sys
print(json.dumps({'properties':{'title':sys.argv[1]}}))
PYEOF
)
    curl -fsS -X POST -H "Authorization: Bearer $T" -H "Content-Type: application/json" -d "$BODY" \
      "https://sheets.googleapis.com/v4/spreadsheets" \
      | python3 -c "import json,sys;print(json.load(sys.stdin).get('spreadsheetId',''))"
    ;;
  copy)
    SRC="${ARGS[1]:-}"; TITLE="${ARGS[2]:-}"
    [ -n "$SRC" ] && [ -n "$TITLE" ] || { echo "copy requires <sourceTitleOrId> <newTitle>" >&2; exit 1; }
    if [ "$DRY_RUN" = 1 ]; then echo "POST drive/v3/files/$SRC/copy (name=$TITLE)"; exit 0; fi
    if [[ "$SRC" != *-*-*-** ]]; then
      SRC=$("$0" find "$SRC" | awk -v t="$SRC" '$2==t{print $1; exit}')
      [ -n "$SRC" ] || { echo "source not found: $SRC" >&2; exit 1; }
    fi
    BODY=$(python3 - "$TITLE" << 'PYEOF'
import json,sys
print(json.dumps({'name':sys.argv[1]}))
PYEOF
)
    curl -fsS -X POST -H "Authorization: Bearer $T" -H "Content-Type: application/json" -d "$BODY" \
      "https://www.googleapis.com/drive/v3/files/$SRC/copy" \
      | python3 -c "import json,sys;print(json.load(sys.stdin).get('id',''))"
    ;;
  trash)
    SID="${ARGS[1]:-}"
    [ -n "$SID" ] || { echo "trash requires a spreadsheetId (find first: mdsheet find <name>)" >&2; exit 1; }
    if [ "$DRY_RUN" = 1 ]; then echo "PATCH drive/v3/files/$SID trashed=true"; exit 0; fi
    curl -fsS -X PATCH -H "Authorization: Bearer $T" -H "Content-Type: application/json" \
      -d '{"trashed": true}' "https://www.googleapis.com/drive/v3/files/$SID" | head -c 100; echo
    ;;
esac