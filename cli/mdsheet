#!/usr/bin/env bash
# mdsheet — MagicDoor timesheet Google Sheets helper (Sheets API v4 via gcloud ADC)
#
# usage:
#   mdsheet [--dry-run] get '<A1range>'
#   mdsheet [--dry-run] set '<singleCellRange>' <file>     whole file into ONE cell (multiline-safe)
#   mdsheet [--dry-run] setmulti '<A1range>' <file>        file lines as one cell per line (COLUMNS)
#   mdsheet [--dry-run] clear '<A1range>'
#   mdsheet find '<name-substring>'                        list spreadsheets by name (Drive API)
#   mdsheet create '<title>'                               create a BARE spreadsheet, print its id
#   mdsheet copy '<sourceTitleOrId>' '<newTitle>'          full-file copy (preserves formatting; template reuse)
#   mdsheet trash '<spreadsheetId>'                        move a spreadsheet to Drive trash
#   mdsheet -h | --help
#
# env:
#   SHEET_ID            (required)
#   TAB                 (default "Daily schedule")
#   MD_SHEET_CACHE=1    cache access token in /tmp/mdsheet_token for ~50 min
#
# auth: Application Default Credentials (gcloud auth application-default login).
# Refresh-token rotation is handled by gcloud; never paste tokens into shells.
set -euo pipefail

DRY_RUN=0
ARGS=()
for a in "$@"; do
  case "$a" in
    --dry-run) DRY_RUN=1 ;;
    --) ;;
    *) ARGS+=("$a") ;;
  esac
done
MODE="${ARGS[0]:-}"; RANGE="${ARGS[1]:-}"

if [ "${ARGS[0]:-}" = "-h" ] || [ "${ARGS[0]:-}" = "--help" ] || [ -z "$MODE" ]; then
  sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'
  exit 0
fi

SHEET_ID="${SHEET_ID:-}"
TAB="${TAB:-Daily schedule}"

case "$MODE" in
  get|set|setmulti|clear)
    : "${SHEET_ID:?SHEET_ID required for cell operations (e.g. export SHEET_ID=1khV... or run: mdsheet find 'Hao-YYYY/MM')}"
    TAB_URLSEG="${TAB// /%20}"
    ;;
  find|create|trash|*) ;;
esac

token() {
  if [ "${MD_SHEET_CACHE:-0}" = "1" ] && [ -s /tmp/mdsheet_token ] && \
     [ $(( $(date +%s) - $(stat -c %Y /tmp/mdsheet_token) )) -lt 3000 ]; then
    cat /tmp/mdsheet_token; return
  fi
  gcloud auth application-default print-access-token > /tmp/mdsheet_token
  cat /tmp/mdsheet_token
}

URL="https://sheets.googleapis.com/v4/spreadsheets/$SHEET_ID/values/${TAB_URLSEG:-}!${RANGE}"
T=$(token)

case "$MODE" in
  get)
    if [ "$DRY_RUN" = 1 ]; then echo "GET $URL"; exit 0; fi
    curl -fsS -H "Authorization: Bearer $T" "$URL" \
      | python3 -c "import json,sys;[print('\t'.join(r)) for r in json.load(sys.stdin).get('values',[[]])]"
    ;;
  set)
    FILE="${ARGS[2]:?'set' requires a file}"
    [ -f "$FILE" ] || { echo "file not found: $FILE" >&2; exit 1; }
    PAYLOAD=$(python3 - "$FILE" << 'PYEOF'
import json,sys
print(json.dumps({"values":[[open(sys.argv[1]).read()]],"majorDimension":"ROWS"}))
PYEOF
)
    if [ "$DRY_RUN" = 1 ]; then echo "PUT $URL?valueInputOption=RAW"; echo "$PAYLOAD" | head -c 200; echo; exit 0; fi
    printf '{"values":[[%s]],"majorDimension":"ROWS"}' "$PAYLOAD" > /dev/null # placeholder never used
    printf '%s' "$PAYLOAD" | curl -fsS -X PUT -H "Authorization: Bearer $T" -H "Content-Type: application/json" \
      --data-binary @- "$URL?valueInputOption=RAW" | head -c 200; echo
    ;;
  setmulti)
    FILE="${ARGS[2]:?'setmulti' requires a file}"
    [ -f "$FILE" ] || { echo "file not found: $FILE" >&2; exit 1; }
    PAYLOAD=$(python3 - "$FILE" << 'PYEOF'
import json,sys
print(json.dumps({"values":[l.rstrip('\n') for l in open(sys.argv[1]).read().split('\n')],"majorDimension":"COLUMNS"}))
PYEOF
)
    if [ "$DRY_RUN" = 1 ]; then echo "PUT $URL?valueInputOption=RAW"; echo "$PAYLOAD" | head -c 200; echo; exit 0; fi
    printf '%s' "$PAYLOAD" | curl -fsS -X PUT -H "Authorization: Bearer $T" -H "Content-Type: application/json" \
      --data-binary @- "$URL?valueInputOption=RAW" | head -c 200; echo
    ;;
  clear)
    if [ "$DRY_RUN" = 1 ]; then echo "POST $URL:clear"; exit 0; fi
    curl -fsS -X POST -H "Authorization: Bearer $T" -H "Content-Type: application/json" "$URL:clear" | head -c 200; echo
    ;;
  find)
    NAME="${ARGS[1]:-}"
    [ -n "$NAME" ] || { echo "find requires a name substring" >&2; exit 1; }
    if [ "$DRY_RUN" = 1 ]; then echo "GET drive/v3/files?q=name contains '$NAME'"; exit 0; fi
    curl -fsS -G -H "Authorization: Bearer $T" \
      --data-urlencode "q=name contains '$NAME' and mimeType='application/vnd.google-apps.spreadsheet' and trashed=false" \
      --data-urlencode "fields=files(id,name)" \
      "https://www.googleapis.com/drive/v3/files" \
      | python3 -c "import json,sys;[print(f['id'], f['name']) for f in json.load(sys.stdin).get('files',[])]"
    ;;
  create)
    TITLE="${ARGS[1]:-}"
    [ -n "$TITLE" ] || { echo "create requires a title" >&2; exit 1; }
    if [ "$DRY_RUN" = 1 ]; then echo "POST sheets/v4/spreadsheets (title=$TITLE)"; exit 0; fi
    BODY=$(python3 - "$TITLE" << 'PYEOF'
import json,sys
print(json.dumps({'properties':{'title':sys.argv[1]}}))
PYEOF
)
    curl -fsS -X POST -H "Authorization: Bearer $T" -H "Content-Type: application/json" -d "$BODY" \
      "https://sheets.googleapis.com/v4/spreadsheets" \
      | python3 -c "import json,sys;print(json.load(sys.stdin).get('spreadsheetId',''))"
    ;;
  copy)
    SRC="${ARGS[1]:-}"; TITLE="${ARGS[2]:-}"
    [ -n "$SRC" ] && [ -n "$TITLE" ] || { echo "copy requires <sourceTitleOrId> <newTitle>" >&2; exit 1; }
    if [ "$DRY_RUN" = 1 ]; then echo "POST drive/v3/files/$SRC/copy (name=$TITLE)"; exit 0; fi
    if [[ "$SRC" != *-*-*-** ]]; then
      SRC=$("$0" find "$SRC" | awk -v t="$SRC" '$2==t{print $1; exit}')
      [ -n "$SRC" ] || { echo "source not found: $SRC" >&2; exit 1; }
    fi
    BODY=$(python3 - "$TITLE" << 'PYEOF'
import json,sys
print(json.dumps({'name':sys.argv[1]}))
PYEOF
)
    curl -fsS -X POST -H "Authorization: Bearer $T" -H "Content-Type: application/json" -d "$BODY" \
      "https://www.googleapis.com/drive/v3/files/$SRC/copy" \
      | python3 -c "import json,sys;print(json.load(sys.stdin).get('id',''))"
    ;;
  trash)
    SID="${ARGS[1]:-}"
    [ -n "$SID" ] || { echo "trash requires a spreadsheetId (find first: mdsheet find <name>)" >&2; exit 1; }
    if [ "$DRY_RUN" = 1 ]; then echo "PATCH drive/v3/files/$SID trashed=true"; exit 0; fi
    curl -fsS -X PATCH -H "Authorization: Bearer $T" -H "Content-Type: application/json" \
      -d '{"trashed": true}' "https://www.googleapis.com/drive/v3/files/$SID" | head -c 100; echo
    ;;
  *)
    echo "usage: mdsheet [--dry-run] get|set|setmulti|clear <range> [file] | find <name> | create <title> | copy <src> <title> | trash <id>" >&2
    exit 1
    ;;
esac