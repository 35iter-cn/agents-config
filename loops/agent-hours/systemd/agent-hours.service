[Unit]
Description=agent-hours — judge ledger units and report to Feishu

[Service]
Type=oneshot
WorkingDirectory=%h/code/agents-config
Environment=PATH=%h/.local/bin:%h/.bun/bin:%h/.volta/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=%h/.bun/bin/bun %h/code/agents-config/loops/agent-hours/hours.mjs
